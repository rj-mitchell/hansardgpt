{$DOMAIN} {
	encode gzip
	# flush_interval -1 streams answers to the browser as they are written (server-sent events)
	reverse_proxy app:8000 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
	}
}

# www and the other domain names: one permanent redirect to the main address
{$REDIRECT_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}
