# Public hostname pointing at this server (Caddy obtains a TLS certificate for it).
DOMAIN=wheretheystand.uk
# Other names pointing at this server; each redirects permanently to DOMAIN (comma-separated).
REDIRECT_DOMAINS="www.wheretheystand.uk, wheretheystand.co.uk, www.wheretheystand.co.uk, wheretheystand.org.uk, www.wheretheystand.org.uk"
# Anthropic API key for written answers (ANTHROPIC_API_KEY also works).
# Without it the app shows ranked, cited sources only.
HANSARD_ANTHROPIC_API_KEY=
# Secret for the admin endpoints (/api/admin/usage, /api/admin/sync); generate with: openssl rand -hex 24
HANSARD_ADMIN_TOKEN=
